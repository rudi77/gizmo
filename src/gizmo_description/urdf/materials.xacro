<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="gizmo_body">
    <color rgba="0.85 0.55 0.15 1.0"/>
  </material>

  <material name="gizmo_head">
    <color rgba="0.95 0.85 0.55 1.0"/>
  </material>

  <material name="gizmo_leg">
    <color rgba="0.30 0.30 0.32 1.0"/>
  </material>

  <material name="gizmo_foot">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="gizmo_arm">
    <color rgba="0.55 0.35 0.10 1.0"/>
  </material>

  <!-- Initial colour of the face display. The MaterialColor Gazebo
       system retints this material at runtime when /gizmo/face_color
       is published, so the value here is just the boot-time look. -->
  <material name="gizmo_face">
    <color rgba="0.7 0.7 0.75 1.0"/>
  </material>

</robot>
